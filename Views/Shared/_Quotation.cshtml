<!-- jQuery and SweetAlert2 -->
<<!-- jQuery and SweetAlert2 -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Animate.css for entry/exit animations -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<!-- Custom styling -->
<style>
    .custom-popup {
        border-radius: 1rem !important;
        padding: 1.5rem !important;
        background: #ffffff;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.15);
    }

    .custom-ok-btn {
        padding: 10px 25px !important;
        font-size: 16px !important;
        border-radius: 8px !important;
        font-weight: 600;
        background-color: #1FA7EA !important;
        color: #fff !important;
    }

    /* Speed up the popup appearance */
    .swal2-popup {
        animation-duration: 0.3s !important; /* Speed up the fade-in animation */
    }
</style>

<!-- jQuery + SweetAlert AJAX Form -->
<script>
    $(document).ready(function () {
        $("#form2").submit(function (event) {
            event.preventDefault(); // Prevent default form submission

            // Show the Thank You popup immediately
                        $("#property-loader").fadeIn(200);

            $.ajax({
                url: "Home/Quotation",
                type: "POST",
                data: $("#form2").serialize(),
                success: function (response) {
                                        $("#property-loader").fadeOut(200); // Hide loader

                    // Close the "Submitting..." popup and show the success message
                    Swal.close();

                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '🎉 Thank You!',
                            html: `<div style="font-size: 16px; line-height: 1.6;">
                                     Your message has been successfully sent.<br>
                                     We'll get back to you as soon as possible.
                                   </div>`,
                            showClass: {
                                popup: 'animate__animated animate__fadeInDown'
                            },
                            hideClass: {
                                popup: 'animate__animated animate__fadeOutUp'
                            },
                            backdrop: true,
                            confirmButtonColor: '#1FA7EA',
                            confirmButtonText: 'Great!',
                            customClass: {
                                popup: 'custom-popup',
                                confirmButton: 'custom-ok-btn'
                            }
                        }).then(() => {
                            $("#popup-default").hide(); // Hide the form after success
                            $("#landForm")[0].reset(); // Optionally reset the form
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            confirmButtonColor: '#1FA7EA',
                            customClass: {
                                popup: 'custom-popup',
                                confirmButton: 'custom-ok-btn'
                            }
                        });
                    }
                },
                error: function () {
                                        $("#property-loader").fadeOut(200); // Hide loader on error

                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Something went wrong!',
                        confirmButtonColor: '#1FA7EA',
                        customClass: {
                            popup: 'custom-popup',
                            confirmButton: 'custom-ok-btn'
                        }
                    });
                }
            });
        });
    });
</script>

<script>
       

    function openPopup(type = 'default') {
        document.querySelectorAll('.popup').forEach(p => p.style.display = 'none');
        const popup = document.getElementById(`popup-${type}`);
        if (popup) {
            popup.style.display = 'flex';
            $("body").addClass("no-scroll"); // Disable scrolling
        } else {
            console.warn(`Popup with ID popup-${type} not found`);
        }
    }

    function closePopup() {
        document.querySelectorAll('.popup').forEach(p => p.style.display = 'none');
        $("body").removeClass("no-scroll"); // Enable scrolling again
    }

</script>
