<style>
    .swal2-container {
        z-index: 2147483647 !important;
    }

    .swal2-popup {
        z-index: 2147483647 !important;
    }

    .custom-ok-btn {
        background-color: #1FA7EA !important;
        color: white !important;
        border: none !important;
    }

        .custom-ok-btn:hover {
            background-color: #1FA7EA !important;
            color: black !important;
        }

    .thank-you-popup {
        background: white;
        border-radius: 10px;
        display: flex;
        width: 30%;
        flex-direction: column;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
        padding: 20px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: none;
        z-index: 99999;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .popup {
        background: white;
        border-radius: 10px;
        display: flex;
        width: 50%;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
        padding: 20px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: none;
        z-index: 99999;
        justify-content: space-between;
    }

        .popup img {
            width: 45%;
            border-radius: 10px;
        }

    .form-container {
        padding: 3px;
        width: 50%;
    }

        .form-container h2 {
            margin-bottom: 10px;
        }

    input, select, textarea {
        width: 100%;
        padding: 10px;
        margin: 8px 0;
        border-radius: 5px;
        background-color: #F0F0F0;
    }

    .price-range {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

        .price-range label {
            display: flex;
            align-items: center;
            gap: 5px;
        }

    .close-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #1fa7ea;
        color: white;
        border: none;
        border-radius: 50%;
        display: flex;
        width: 40px;
        height: 40px;
        font-size: 30px;
        font-weight: bold;
        cursor: pointer;
        justify-content: center;
        align-items: center;
    }

    .great-day {
        width: 155px;
        height: 45px;
        background-color: #0B579C;
        color: white;
        margin: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 10px;
    }

    @@media (max-width: 800px) {
        .popup

    {
        width: 90%;
        flex-direction: column-reverse;
        align-items: center;
    }

    .form-container {
        width: 100%;
    }

    .popup img {
        display: none;
    }

    .thank-you-popup {
        width: 90%;
    }

    }

    /* Loader Styles */
    #property-loader {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2147483647 !important;
        background: #fff;
        padding: 30px 40px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
        display: none;
    }

    .loader-content {
        display: flex;
        flex-direction: column;
        align-items: center; /* Centers icon and text horizontally */
        justify-content: center; /* Optional, for vertical alignment within parent */
        text-align: center;
    }

    .loader-icon {
        width: 50px;
        height: 40px;
        margin-bottom: 12px;
        animation: bounce 1s infinite;
    }

     /*    #property-loader p {
            font-size: 16px;
            color: #1FA7EA;
            font-weight: bold;
            animation: fadeIn 1s ease-in-out infinite alternate;
        } */

    @@keyframes bounce {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }

    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0.4;
    }

    to {
        opacity: 1;
    }

    }
</style>

<!-- Form Popup -->
<div class="popup" id="entire_popup">
    <button class="close-btn" onclick="closePopup()">&times;</button>
    <img src="/assets/images/home/Mask group.png" alt="House">

    <div class="form-container">
        <form id="landForm" method="post">
            <h2>Let's Connect!!</h2>
            <input type="text" name="FullName" placeholder="Full Name" required>
            <input type="email" name="Email" placeholder="Email Address" required>
            <input type="tel" name="PhoneNumber" placeholder="Phone Number" required>
            <select name="Category" required>
                <option>Select Category</option>
                <option value="Buy">Buy</option>
                <option value="Rent">Rent</option>
                <option value="Sell">Sell</option>
            </select>
            <h5 class="text-dark-blu">Budget Range</h5>
            <div class="price-range">
                <label><input type="radio" name="Budget" value="$700K"> $700K</label>
                <label><input type="radio" name="Budget" value="$900K"> $900K</label>
                <label><input type="radio" name="Budget" value="$1.2M"> $1.2M</label>
                <label><input type="radio" name="Budget" value="$1.5M"> $1.5M</label>
            </div>
            <textarea name="Message" placeholder="Type your detailed message here..."></textarea>
            <button type="submit" class="text-white font-medium text-[16px] leading-none tracking-[0.02em] bg-secondary py-[17px] px-[20px] mt-5 sm:mt-0 rounded-[10px] hover:bg-white hover:text-primary transition-all sm:right-[4px] sm:top-1/2" style="width: 100%;">Submit</button>
        </form>
    </div>
</div>

<!-- Success Popup -->
<div class="thank-you-popup" id="thankYouPopup">
    <h2>Thank you!</h2>
    <p>Your message has been received. Have a great day!</p>
</div>

<!-- Loader -->
<!-- Loader -->
<!-- Loader -->
<div id="property-loader">
    <div class="loader-content">
        <img src="/assets/images/icon/HOME_32PX.png" alt="Loading..." class="loader-icon">
        <p>Processing your request please wait...</p>
    </div>
</div>



<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function closePopup() {
        document.getElementById('entire_popup').style.display = 'none';
    }

    $(document).ready(function () {
        $("#landForm").submit(function (event) {
            event.preventDefault();

            $("#property-loader").fadeIn(300);

            $.ajax({
                url: '@Url.Action("LandingPageQuotation", "Home")',
                type: "POST",
                data: $("#landForm").serialize(),
                success: function (response) {
                    $("#property-loader").fadeOut(300);

                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '🎉 Thank You!',
                            html: `<div style="font-size: 16px; line-height: 1.6;">
                                     Your message has been successfully sent.<br>
                                     We'll get back to you as soon as possible.
                                   </div>`,
                            backdrop: true,
                            confirmButtonColor: '#1FA7EA',
                            confirmButtonText: 'Great!',
                            customClass: {
                                confirmButton: 'custom-ok-btn'
                            }
                        }).then(() => {
                            $("#landForm")[0].reset();
                            $("#entire_popup").hide();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            backdrop: true,
                            confirmButtonColor: '#1FA7EA',
                            customClass: {
                                confirmButton: 'custom-ok-btn'
                            }
                        });
                    }
                },
                error: function () {
                    $("#property-loader").fadeOut(300);
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Something went wrong!',
                        confirmButtonColor: '#1FA7EA',
                        backdrop: true,
                        customClass: {
                            confirmButton: 'custom-ok-btn'
                        }
                    });
                }
            });
        });
    });
</script>
