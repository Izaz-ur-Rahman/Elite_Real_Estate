    }

/* loader css here*/
    #property-loader {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2147483647 !important;
        background: #ffffff;
        padding: 20px 30px;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        #property-loader .house {
            position: relative;
            width: 60px;
            height: 60px;
            animation: bounce 1s infinite;
        }

        #property-loader .roof {
            width: 0;
            height: 0;
            border-left: 30px solid transparent;
            border-right: 30px solid transparent;
            border-bottom: 25px solid #1FA7EA;
            position: absolute;
            top: 0;
            left: 75px !important;
        }

    @@media (max-width: 767px) {
        #property-loader .roof {
            left: 40px !important;
        }

        #property-loader .walls {
            left: 40px !important;
        }

        #property-loader .door {
            left: 63.5px !important;
        }
    }

    #property-loader .walls {
            width: 60px;
            height: 35px;
            background: #1FA7EA;
            position: absolute;
            top: 25px;
            left: 75px !important;
        }

        #property-loader .door {
            width: 15px;
            height: 20px;
            background: #ffffff;
            position: absolute;
            bottom: 5px;
            left: 97.5px !important;
            border-radius: 2px;
        }

        #property-loader p {
            margin-top: 16px;
            font-size: 16px;
            color: #1FA7EA;
            font-weight: bold;
            animation: fadeIn 1s ease-in-out infinite alternate;
        }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0.4;
        }

        to {
            opacity: 1;
        }
    }
</style>

<div class="popup" id="entire_popup">
    <button class="close-btn" onclick="closePopup()">&times;</button>

    <img src="~/assets/images/home/Mask group.png" alt="House">

    <div class="form-container">
        <form id="landForm" method="post">
            <h2>Let's Connect!!</h2>
            <input type="text" name="FullName" placeholder="Full Name" required>
            <input type="email" name="Email" placeholder="Email Address" required>
            <input type="tel" name="PhoneNumber" placeholder="Phone Number" required>
            <select name="Category" required>
                <option>Select Category</option>
                <option value="Buy">Buy</option>
                <option value="Rent">Rent</option>
                <option value="Sell">Sell</option>
            </select>
            <h5 class="text-dark-blu">Budget Range</h5>
            <div class="price-range">
                <label><input type="radio" name="Budget" value="$700K"> $700K</label>
                <label><input type="radio" name="Budget" value="$900K"> $900K</label>
                <label><input type="radio" name="Budget" value="$1.2M"> $1.2M</label>
                <label><input type="radio" name="Budget" value="$1.5M"> $1.5M</label>
            </div>
            <textarea name="Message" placeholder="Type your detailed message here..."></textarea>
            <button type="submit" class="text-white font-medium text-[16px] leading-none tracking-[0.02em] bg-secondary py-[17px] px-[20px] mt-5 sm:mt-0 rounded-[10px] hover:bg-white hover:text-primary transition-all sm:right-[4px] sm:top-1/2" style="width: 100%;">Submit</button>
        </form>
    </div>
</div>

<!-- Success Popup Placeholder -->
<div class="thank-you-popup" id="thankYouPopup">
    <h2>Thank you!</h2>
    <p>Your message has been received. Have a great day!</p>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Custom Real Estate Loader -->
<div id="property-loader" style="display:none;">
    <div class="house">
        <div class="roof"></div>
        <div class="walls"></div>
        <div class="door"></div>
    </div>
    <p>Processing your request...</p>
</div>


<script>
    $(document).ready(function () {
        $("#landForm").submit(function (event) {
            event.preventDefault();

            // Show the custom house loader before the AJAX request
            $("#property-loader").fadeIn(300); // Show the loader immediately with fadeIn

            // Trigger the AJAX request after showing the loader
            $.ajax({
                url: '@Url.Action("LandingPageQuotation", "Home")', // Replace with your actual URL
                type: "POST",
                data: $("#landForm").serialize(),
                success: function (response) {
                    // Hide the loader after the response is received
                    $("#property-loader").fadeOut(300);

                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '🎉 Thank You!',
                            html: `<div style="font-size: 16px; line-height: 1.6;">
                                     Your message has been successfully sent.<br>
                                     We'll get back to you as soon as possible.
                                   </div>`,
                            backdrop: true,
                            confirmButtonColor: '#1FA7EA',
                            confirmButtonText: 'Great!',
                            customClass: {
                                confirmButton: 'custom-ok-btn'
                            }
                        }).then(() => {
                            // Reset the form after success
                            $("#landForm")[0].reset();
                            $("#entire_popup").hide(); // Hide the form after success
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            backdrop: true,
                            confirmButtonColor: '#1FA7EA',
                            customClass: {
                                confirmButton: 'custom-ok-btn'
                            }
                        });
                    }
                },
                error: function () {
                    // Hide loader and show error popup if something goes wrong
                    $("#property-loader").fadeOut(300);
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Something went wrong!',
                        confirmButtonColor: '#1FA7EA',
                        backdrop: true,
                        customClass: {
                            confirmButton: 'custom-ok-btn'
                        }
                    });
                }
            });
        });
    });
</script>
