    }

    @@keyframes fadeSlideIn {
        0% {
            opacity: 0;
            transform: translateY(15px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseBounce {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05) translateY(-4px);
        }
    }

    @@keyframes shine {
        0% {
            left: -75%;
        }

        100% {
            left: 125%;
        }
