<script>
               function openPopup(type = 'default') {
        // Hide all popups
        document.querySelectorAll('.popup').forEach(p => p.style.display = 'none');
                 console.log("Form opened!"); // Log form submission
                 console.log(document.getElementById('popup-default'));

        // Get the right popup
        const popup = document.getElementById(`popup-${type}`);
        if (popup) {
            popup.style.display = 'flex';
            document.body.classList.add('popup-active');
        } else {
            console.warn(`Popup with ID popup-${type} not found`);
        }
    }

    function closePopup() {
        document.querySelectorAll('.popup').forEach(p => p.style.display = 'none');
        document.body.classList.remove('popup-active');
    }

    // Add event listener for close buttons
    document.querySelectorAll(".close-btn").forEach(btn => {
        btn.addEventListener("click", closePopup);
    });

    function showThankYou() {
        closePopup();
        const thankYou = document.querySelector('.thank-you-popup');
        if (thankYou) {
            thankYou.style.display = 'flex';
            setTimeout(() => {
                thankYou.style.display = 'none';
            }, 2000);
        }
    }

</script>

