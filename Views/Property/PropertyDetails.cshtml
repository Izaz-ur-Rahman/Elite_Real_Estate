<style>

    /* Parent container */
    .image-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* Large Image */
    .large-image-container {
        flex: 2;
        max-width: 74%;
    }

    .large-img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 5px;
    }

    /* Thumbnail Images (Desktop: Vertical, Mobile: Horizontal) */
    .thumbnail-container {
        flex: 1;
        display: flex;
        flex-direction: column; /* Vertical thumbnails by default */
        gap: 8px;
        max-width: 25%;
    }

    .thumbnail-img {
        width: 100%;
        cursor: pointer;
        border-radius: 5px;
        transition: transform 0.2s ease-in-out;
    }

        .thumbnail-img:hover {
            transform: scale(1.05);
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .image-gallery {
            flex-direction: column;
            align-items: center;
        }

        .large-image-container {
            max-width: 100%;
        }

        .thumbnail-container {
            max-width: 100%;
            flex-direction: row; /* Horizontal thumbnails on small screens */
            justify-content: center;
        }

        .thumbnail-img {
            width: 30%; /* Adjust based on number of images */
        }

        .hamburger-icon {
            width: 28px;
            height: 28px;
            fill: #016450; /* Initial green */
            transition: fill 0.3s ease;
        }

        .hamburger-scrolled {
            fill: black !important;
        }

        .fill-current {
            fill: black;
        }

        .py-\[80px\] {
            padding-top: 40px;
            padding-bottom: 40px;
        }
    }
    /* Hide mobile agent profile on desktop */
    @@media (min-width: 1024px) {
        .mobile-agent-profile {
            display: none;
        }
    }

    /* Hide desktop agent profile on mobile */
    @@media (max-width: 1023px) {
        .asidebar .mb-[60px] { /* Target the desktop agent profile */
            display: none;
        }
    }

</style>

